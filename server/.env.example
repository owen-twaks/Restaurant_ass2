# Copy this file to .env and fill in the values.
# NEVER commit .env — it contains your database password and auth secret.

# The connection string Neon gave you for the Postgres database.
# It starts with postgres:// and contains your username and password.
DATABASE_URL=postgres://

# A long random string used to sign/encrypt auth tokens.
# Generate one with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=

# Better Auth (sign-in / sign-up) settings.
# A long random string that signs the session cookie. NEVER commit the real value.
# Generate one with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
BETTER_AUTH_SECRET=

# The address of this server. Better Auth builds reset links from it.
BETTER_AUTH_URL=http://localhost:5000

# The address of the React client. CORS only allows this origin to send cookies.
# The address of the React client that browsers send cookies from.
# Keep this in sync with the CORS origin on the Express server.
CLIENT_ORIGIN=http://localhost:5173

# URL your frontend uses in production. It is also passed to Stripe as
# the 'clientReferenceId' on the checkout session (and shown in your
# Stripe dashboard), so it must be the public Vercel URL, e.g.
# https://my-restaurant.vercel.app
CLIENT_URL=http://localhost:5173

# Stripe secret key. This is ONLY used to call the Stripe API from the
# server (create a checkout session and verify the webhook). ALWAYS
# test mode. Generate real keys at https://dashboard.stripe.com/test/apikeys
# and paste them here. NEVER commit the real value.
STRIPE_SECRET_KEY=REPLACE_WITH_YOUR_OWN_STRIPE_TEST_SECRET_KEY

# Webhook signing secret. Stripe signs every webhook event with this.
# It is used to prove the request really came from Stripe. Generate it at
# https://dashboard.stripe.com/test/webhooks  (event: checkout.session.completed)
# NEVER commit the real value.
STRIPE_WEBHOOK_SECRET=REPLACE_WITH_YOUR_OWN_STRIPE_WEBHOOK_SIGNING_SECRET
