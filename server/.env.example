# Copy this file to .env and fill in the values.
# NEVER commit .env — it contains your database password and auth secret.

# The connection string Neon gave you for the Postgres database.
# It starts with postgres:// and contains your username and password.
DATABASE_URL=postgres://

# A long random string used to sign/encrypt auth tokens.
# Generate one with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=

# Better Auth (sign-in / sign-up) settings.
# A long random string that signs the session cookie. NEVER commit the real value.
# Generate one with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
BETTER_AUTH_SECRET=

# The address of this server. Better Auth builds reset links from it.
BETTER_AUTH_URL=http://localhost:5000

# The address of the React client. CORS only allows this origin to send cookies.
CLIENT_ORIGIN=http://localhost:5173
